# Gemini API Key (Recommended, free tier available)
GEMINI_API_KEY=

# OpenRouter API Key (Optional alternative)
OPENROUTER_API_KEY=

# Hunt Secret — protects the POST /api/hunt template ingestion endpoint.
# Set this to any strong random string. The UI sends it as Authorization: Bearer <token>.
# Keep this secret. Never commit the actual value.
HUNT_SECRET=your-strong-random-secret-here
